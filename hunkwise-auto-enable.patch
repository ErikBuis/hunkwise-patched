+    assert.equal(await post(port, input, { Host: `evil.example:${port}` }), 403);
+    assert.equal(await post(port, input, {}, 'GET'), 404);
+    assert.equal(fs.existsSync(eventsDir) ? readEvents().length : 0, 0);
+  });
+
+  it('lets a second window take over the port when the first one closes', async () => {
