+    const created = path.join(tmpDir, 'new.txt');
+
+    await post(port, hookInput('PreToolUse', 'Write', { file_path: 'new.txt', content: 'x' }));
+    fs.writeFileSync(created, 'x');
+    await post(port, hookInput('PostToolUse', 'Write', { file_path: 'new.txt', content: 'x' }));
