new file mode 100644
index 0000000..63af481
--- /dev/null
+++ b/src/test/changedRanges.test.ts
@@ -0,0 +1,33 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { changedRanges } from '../diffEngine';
+
+describe('changedRanges', () => {
+  it('highlights only the changed word', () => {
+    const result = changedRanges(['const x = 1;'], ['const y = 1;']);
+    assert.deepEqual(result.removed, [{ line: 0, start: 6, end: 7 }]);
+    assert.deepEqual(result.added, [{ line: 0, start: 6, end: 7 }]);
+  });
+
+  it('splits changes across lines and leaves out line breaks', () => {
+    const result = changedRanges(['a b', 'c d'], ['a X', 'Y d']);
+    assert.deepEqual(result.added, [{ line: 0, start: 2, end: 3 }, { line: 1, start: 0, end: 1 }]);
+    assert.deepEqual(result.removed, [{ line: 0, start: 2, end: 3 }, { line: 1, start: 0, end: 1 }]);
+  });
+
+  it('covers an inserted line in full', () => {
+    const result = changedRanges(['a'], ['a', 'new line']);
+    assert.deepEqual(result.removed, []);
+    assert.deepEqual(result.added, [{ line: 1, start: 0, end: 8 }]);
+  });
+
+  it('has no ranges for pure additions and deletions', () => {
+    assert.deepEqual(changedRanges([], ['a']), { removed: [], added: [] });
+    assert.deepEqual(changedRanges(['a'], []), { removed: [], added: [] });
+  });
+
+  it('skips very large hunks', () => {
+    const big = ['x'.repeat(30000)];
+    assert.deepEqual(changedRanges(big, ['y']), { removed: [], added: [] });
+  });
+});
diff --git a/src/test/claudeHooks.test.ts b/src/test/claudeHooks.test.ts
new file mode 100644
index 0000000..360b0b8
--- /dev/null
+++ b/src/test/claudeHooks.test.ts
@@ -0,0 +1,224 @@
+import { describe, it, beforeEach, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import * as fs from 'fs';
+import * as http from 'http';
+import * as net from 'net';
+import * as os from 'os';
+import * as path from 'path';
+import { ClaudeHookServer, ClaudeToolEvent, ClaudeToolTracker, HOOK_PATH } from '../claudeHooks';
+
+let tmpDir: string;
+let eventsDir: string;
+let file: string;
+const servers: ClaudeHookServer[] = [];
+const trackers: ClaudeToolTracker[] = [];
+
+function freePort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const probe = net.createServer();
+    probe.once('error', reject);
+    probe.listen(0, '127.0.0.1', () => {
+      const port = (probe.address() as net.AddressInfo).port;
+      probe.close(() => resolve(port));
+    });
+  });
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+async function waitFor(condition: () => boolean, timeoutMs = 5000): Promise<void> {
+  const start = Date.now();
+  while (!condition()) {
+    if (Date.now() - start > timeoutMs) throw new Error('Condition not met in time');
+    await sleep(20);
+  }
+}
+
+/** Send a hook request the way Claude Code does. */
+function post(port: number, body: unknown, headers: Record<string, string> = {}, method = 'POST'): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const data = JSON.stringify(body);
+    const req = http.request(
+      { host: '127.0.0.1', port, path: HOOK_PATH, method, headers: { 'Content-Type': 'application/json', ...headers } },
+      res => { res.resume(); res.on('end', () => resolve(res.statusCode ?? 0)); },
+    );
+    req.on('error', reject);
+    req.end(data);
+  });
+}
+
+function hookInput(event: string, tool: string, toolInput: Record<string, unknown>, id = 'toolu_1'): Record<string, unknown> {
+  return { session_id: 's1', cwd: tmpDir, hook_event_name: event, tool_name: tool, tool_input: toolInput, tool_use_id: id };
+}
+
+function readEvents(): ClaudeToolEvent[] {
+  return fs.readdirSync(eventsDir)
+    .filter(n => n.endsWith('.json'))
+    .sort()
+    .map(n => JSON.parse(fs.readFileSync(path.join(eventsDir, n), 'utf-8')));
+}
+
+function newServer(port: number): ClaudeHookServer {
+  const server = new ClaudeHookServer(port, eventsDir);
+  servers.push(server);
+  return server;
+}
+
+beforeEach(() => {
+  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'hunkwise-hooks-test-'));
+  eventsDir = path.join(tmpDir, 'events');
+  file = path.join(tmpDir, 'file.txt');
+  fs.writeFileSync(file, 'original\n');
+});
+
+afterEach(() => {
+  servers.splice(0).forEach(s => s.dispose());
+  trackers.splice(0).forEach(t => t.dispose());
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+});
+
+describe('ClaudeHookServer', () => {
+  it('records an Edit call with the file content before and after', async () => {
+    const port = await freePort();
+    const server = newServer(port);
+    server.start();
+    await waitFor(() => server.listening);
+
+    assert.equal(await post(port, hookInput('PreToolUse', 'Edit', { file_path: file })), 200);
+    fs.writeFileSync(file, 'changed\n');
+    assert.equal(await post(port, hookInput('PostToolUse', 'Edit', { file_path: file })), 200);
+
+    const [pre, done] = readEvents();
+    assert.equal(pre.kind, 'pre');
+    assert.equal(pre.before, 'original\n');
+    assert.equal(done.kind, 'post');
+    assert.equal(done.before, 'original\n');
+    assert.equal(done.after, 'changed\n');
+    assert.equal(done.id, 'toolu_1');
+  });
+
+  it('records a Write that creates a file with a null before', async () => {
+    const port = await freePort();
+    const server = newServer(port);
+    server.start();
+    await waitFor(() => server.listening);
+    const created = path.join(tmpDir, 'new.txt');
+
+    await post(port, hookInput('PreToolUse', 'Write', { file_path: 'new.txt', content: 'x' }));
+    fs.writeFileSync(created, 'x');
+    await post(port, hookInput('PostToolUse', 'Write', { file_path: 'new.txt', content: 'x' }));
+
+    const [pre, done] = readEvents();
+    assert.equal(pre.filePath, created, 'Relative paths are resolved against the hook cwd');
+    assert.equal(pre.before, null);
+    assert.equal(done.after, 'x');
+  });
+
+  it('ignores tools that do not name the file they change, such as Bash', async () => {
+    const port = await freePort();
+    const server = newServer(port);
+    server.start();
+    await waitFor(() => server.listening);
+
+    assert.equal(await post(port, hookInput('PreToolUse', 'Bash', { command: 'rm file.txt' })), 200);
+    assert.equal(fs.existsSync(eventsDir) ? readEvents().length : 0, 0);
+  });
+
+  it('rejects requests that do not look like Claude Code hooks', async () => {
+    const port = await freePort();
+    const server = newServer(port);
+    server.start();
+    await waitFor(() => server.listening);
+    const input = hookInput('PreToolUse', 'Edit', { file_path: file });
+
+    assert.equal(await post(port, input, { 'Content-Type': 'text/plain' }), 403);
+    assert.equal(await post(port, input, { Host: `evil.example:${port}` }), 403);
+    assert.equal(await post(port, input, {}, 'GET'), 404);
+    assert.equal(fs.existsSync(eventsDir) ? readEvents().length : 0, 0);
+  });
+
+  it('lets a second window take over the port when the first one closes', async () => {
+    const port = await freePort();
+    const first = newServer(port);
+    first.start();
+    await waitFor(() => first.listening);
+    const second = newServer(port);
+    second.start();
+    await sleep(200);
+    assert.ok(!second.listening, 'Only one window can listen');
+
+    first.dispose();
+    await waitFor(() => second.listening, 6000);
+  });
+});
+
+describe('ClaudeToolTracker', () => {
+  function newTracker() {
+    const started: { id: string; filePath: string }[] = [];
+    const done: { id: string; filePath: string; before: string | null | undefined; after: string | null | undefined }[] = [];
+    const abandoned: { id: string; filePath: string }[] = [];
+    const tracker = new ClaudeToolTracker(eventsDir, {
+      onToolStarted: e => started.push(e),
+      onToolDone: e => done.push(e),
+      onAbandoned: e => abandoned.push(e),
+    });
+    trackers.push(tracker);
+    tracker.start();
+    return { tracker, started, done, abandoned };
+  }
+
+  it('knows a file is being worked on between the pre and post events', () => {
+    const server = newServer(0);
+    const { tracker, started, done } = newTracker();
+
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    assert.ok(tracker.isWorkingOn(file));
+    assert.deepEqual(started, [{ id: 'toolu_1', filePath: file }], 'The start is reported before the tool writes');
+    if (process.platform === 'win32') assert.ok(tracker.isWorkingOn(file.toUpperCase()), 'Windows paths match case-insensitively');
+    assert.ok(!tracker.isWorkingOn(path.join(tmpDir, 'other.txt')));
+
+    fs.writeFileSync(file, 'changed\n');
+    server.process(hookInput('PostToolUse', 'Edit', { file_path: file }));
+    assert.ok(!tracker.isWorkingOn(file));
+    assert.deepEqual(done, [{ id: 'toolu_1', filePath: file, before: 'original\n', after: 'changed\n' }]);
+  });
+
+  it('treats a failed tool call as finished', () => {
+    const server = newServer(0);
+    const { tracker, done } = newTracker();
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    server.process(hookInput('PostToolUseFailure', 'Edit', { file_path: file }));
+    tracker.catchUp();
+    assert.equal(done.length, 1);
+    assert.equal(done[0].before, done[0].after);
+  });
+
+  it('reports a denied tool call as abandoned', () => {
+    const server = newServer(0);
+    const { tracker, done, abandoned } = newTracker();
+    server.process(hookInput('PreToolUse', 'Write', { file_path: file }));
+    server.process(hookInput('PermissionDenied', 'Write', { file_path: file }));
+    assert.ok(!tracker.isWorkingOn(file));
+    assert.deepEqual(abandoned, [{ id: 'toolu_1', filePath: file }]);
+    assert.equal(done.length, 0);
+  });
+
+  it('ignores events from before it started', () => {
+    const server = newServer(0);
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    const { tracker } = newTracker();
+    assert.ok(!tracker.isWorkingOn(file));
+  });
+
+  it('uses the before content from the post event when it missed the pre event', () => {
+    const server = newServer(0);
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    const { tracker, done } = newTracker();
+    fs.writeFileSync(file, 'changed\n');
+    server.process(hookInput('PostToolUse', 'Edit', { file_path: file }));
+    tracker.catchUp();
+    assert.deepEqual(done, [{ id: 'toolu_1', filePath: file, before: 'original\n', after: 'changed\n' }]);
+  });
+});
diff --git a/src/test/hunkInsetHtml.test.ts b/src/test/hunkInsetHtml.test.ts
new file mode 100644
index 0000000..e32cdf6
--- /dev/null
+++ b/src/test/hunkInsetHtml.test.ts
@@ -0,0 +1,62 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { buildHunkHtml } from '../hunkInsetHtml';
+
+function unescapeHtml(s: string): string {
+  return s.replace(/&quot;/g, '"').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&');
+}
+
+/** The JavaScript in each onclick attribute, as the browser would run it. */
+function onclickHandlers(html: string): string[] {
+  return [...html.matchAll(/onclick="([^"]*)"/g)].map(m => unescapeHtml(m[1]));
+}
+
+const EDGE = { scrollbarWidth: 14 };
+
+describe('buildHunkHtml', () => {
+  const filePath = 'C:\\Users\\me\\"quoted" <dir>\\file.ts';
+
+  it('produces a script and click handlers that parse', () => {
+    for (const edge of [EDGE, { scrollbarWidth: 10, minimap: { maxColumn: 120, scale: 2 } }]) {
+      const html = buildHunkHtml(filePath, '3:1:3:1', ['old line'], [], 4, 2, { kind: 'width' }, edge);
+      const script = html.match(/<script>([\s\S]*)<\/script>/)?.[1];
+      assert.ok(script);
+      assert.doesNotThrow(() => new Function(script));
+      const handlers = onclickHandlers(html);
+      assert.equal(handlers.length, 2);
+      for (const handler of handlers) assert.doesNotThrow(() => new Function('send', handler));
+    }
+  });
+
+  it('sends the file path and hunk id unchanged', () => {
+    const html = buildHunkHtml(filePath, '3:1:3:1', [], [], 4, 1, { kind: 'off' }, EDGE);
+    const sent: unknown[] = [];
+    for (const handler of onclickHandlers(html)) new Function('send', handler)((msg: unknown) => sent.push(msg));
+    assert.deepEqual(sent, [
+      { command: 'accept', filePath, hunkId: '3:1:3:1' },
+      { command: 'discard', filePath, hunkId: '3:1:3:1' },
+    ]);
+  });
+
+  it('escapes removed lines', () => {
+    const html = buildHunkHtml(filePath, 'id', ['<script>alert(1)</script> & "x"'], [], 4, 2, { kind: 'off' }, EDGE);
+    assert.ok(html.includes('&lt;script&gt;alert(1)&lt;/script&gt; &amp; &quot;x&quot;'));
+    assert.equal(html.match(/<script>/g)?.length, 1);
+  });
+
+  it('wraps removed lines only when the editor wraps', () => {
+    assert.match(buildHunkHtml(filePath, 'id', ['x'], [], 4, 2, { kind: 'off' }, EDGE), /\.line \{ white-space: pre;/);
+    assert.match(buildHunkHtml(filePath, 'id', ['x'], [], 4, 2, { kind: 'width' }, EDGE), /\.line \{ white-space: pre-wrap;/);
+    assert.match(buildHunkHtml(filePath, 'id', ['x'], [], 4, 2, { kind: 'column', column: 100 }, EDGE), /max-width: 100ch;/);
+  });
+
+  it('highlights the changed parts of removed lines', () => {
+    const html = buildHunkHtml(filePath, 'id', ['const x = 1;', 'a<b'], [{ line: 0, start: 6, end: 7 }, { line: 1, start: 1, end: 2 }], 4, 2, { kind: 'off' }, EDGE);
+    assert.ok(html.includes('<div class="line">const <span class="changed">x</span> = 1;</div>'));
+    assert.ok(html.includes('<div class="line">a<span class="changed">&lt;</span>b</div>'));
+  });
+
+  it('leaves out the removed block for a pure addition', () => {
+    assert.ok(!buildHunkHtml(filePath, 'id', [], [], 4, 1, { kind: 'off' }, EDGE).includes('class="removed"'));
+  });
+});
