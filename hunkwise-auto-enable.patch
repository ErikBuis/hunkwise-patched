diff --git a/src/reviewUi.ts b/src/reviewUi.ts
new file mode 100644
index 0000000..960b379
--- /dev/null
+++ b/src/reviewUi.ts
@@ -0,0 +1,136 @@
+import * as vscode from 'vscode';
+import * as path from 'path';
+import { StateManager } from './stateManager';
+import { computeHunks, ParsedHunk } from './diffEngine';
+import { normalizePath } from './pathNormalize';
+
+/** Context key that tells menus whether the active editor has hunks to review. */
+const HAS_HUNKS_CONTEXT = 'hunkwise.activeEditorHasHunks';
+
+/** The hunks of a file under review, as they are in the given document right now. */
+export function hunksOf(stateManager: StateManager, document: vscode.TextDocument): ParsedHunk[] {
+  if (document.uri.scheme !== 'file') return [];
+  const state = stateManager.getFile(normalizePath(document.uri.fsPath));
+  if (state?.status !== 'reviewing') return [];
+  return computeHunks(state.baseline, document.getText());
+}
+
+/**
+ * Scroll a hunk into view so that its Accept / Discard buttons always end up at the same spot:
+ * right below the middle of the editor. That way you can click through a file's hunks without
+ * moving the mouse.
+ */
+export function revealHunk(editor: vscode.TextEditor, hunk: ParsedHunk): void {
+  const first = Math.max(0, hunk.newStart - 1);
+  editor.selection = new vscode.Selection(first, 0, first, 0);
+  // The buttons sit right below the line before the hunk, so center that line.
+  const anchor = Math.max(0, hunk.newStart - 2);
+  editor.revealRange(new vscode.Range(anchor, 0, anchor, 0), vscode.TextEditorRevealType.InCenter);
+}
+
+/** Colors and badges the files (and their folders) in the Explorer that have Claude changes to review. */
+export class ReviewDecorationProvider implements vscode.FileDecorationProvider, vscode.Disposable {
+  private readonly emitter = new vscode.EventEmitter<vscode.Uri[]>();
+  readonly onDidChangeFileDecorations = this.emitter.event;
+  // Decorated paths: files under review, and every folder that contains one.
+  private files: Set<string> = new Set();
+  private folders: Set<string> = new Set();
+
+  constructor(private readonly stateManager: StateManager) {}
+
+  provideFileDecoration(uri: vscode.Uri): vscode.FileDecoration | undefined {
+    if (uri.scheme !== 'file') return undefined;
+    const filePath = normalizePath(uri.fsPath);
+    const color = new vscode.ThemeColor('hunkwise.claudeChangeForeground');
+    if (this.files.has(filePath)) {
+      const isNew = this.stateManager.getFile(filePath)?.baseline === null;
+      return new vscode.FileDecoration('✦', isNew ? 'Created by Claude, not reviewed yet' : 'Changed by Claude, not reviewed yet', color);
+    }
+    // Folders get their own decoration instead of a propagated one, which VS Code shows as a
+    // plain dot that is easily hidden behind Git's.
+    if (this.folders.has(filePath)) return new vscode.FileDecoration('✦', 'Contains Claude changes that are not reviewed yet', color);
+    return undefined;
+  }
+
+  /** Update the Explorer after files entered or left review. */
+  refresh(): void {
+    const root = vscode.workspace.workspaceFolders?.[0]?.uri.fsPath;
+    const files = new Set<string>();
+    const folders = new Set<string>();
+    for (const [filePath, state] of this.stateManager.getAllFiles()) {
+      if (state.status !== 'reviewing') continue;
+      files.add(filePath);
+      for (let dir = path.dirname(filePath); root && dir.length >= root.length && !folders.has(dir); dir = path.dirname(dir)) {
+        folders.add(dir);
+        if (dir === path.dirname(dir)) break;
+      }
+    }
+    const changed = [
+      ...symmetricDifference(this.files, files),
+      ...symmetricDifference(this.folders, folders),
+    ];
+    this.files = files;
+    this.folders = folders;
+    if (changed.length > 0) this.emitter.fire(changed.map(p => vscode.Uri.file(p)));
+  }
+
+  dispose(): void {
+    this.emitter.dispose();
+  }
+}
+
+function symmetricDifference(a: Set<string>, b: Set<string>): string[] {
+  return [...a].filter(x => !b.has(x)).concat([...b].filter(x => !a.has(x)));
+}
+
+/**
+ * Commands for the file in the active editor: previous / next hunk, and Accept All / Discard
+ * All. They are in the editor title bar while the file has hunks.
+ */
+export class ActiveFileControls implements vscode.Disposable {
+  private readonly disposables: vscode.Disposable[] = [];
+
+  constructor(
+    private readonly stateManager: StateManager,
+    acceptFile: (filePath: string) => Thenable<void> | void,
+    discardFile: (filePath: string) => Thenable<void> | void,
+  ) {
+    const withActiveFile = (action: (filePath: string) => Thenable<void> | void) => async () => {
+      const editor = vscode.window.activeTextEditor;
+      if (editor && hunksOf(this.stateManager, editor.document).length > 0) {
+        await action(normalizePath(editor.document.uri.fsPath));
+      }
+    };
+    this.disposables.push(
+      vscode.commands.registerCommand('hunkwise.nextHunk', () => this.navigate(1)),
+      vscode.commands.registerCommand('hunkwise.previousHunk', () => this.navigate(-1)),
+      vscode.commands.registerCommand('hunkwise.acceptAllInFile', withActiveFile(acceptFile)),
+      vscode.commands.registerCommand('hunkwise.discardAllInFile', withActiveFile(discardFile)),
+      vscode.window.onDidChangeActiveTextEditor(() => this.refresh()),
+    );
+    this.refresh();
+  }
+
+  /** Move the cursor to the next (direction 1) or previous (-1) hunk, wrapping around. */
+  private navigate(direction: 1 | -1): void {
+    const editor = vscode.window.activeTextEditor;
+    if (!editor) return;
+    const hunks = hunksOf(this.stateManager, editor.document);
+    if (hunks.length === 0) return;
+    const line = editor.selection.active.line;
+    const target = direction === 1
+      ? hunks.find(h => h.newStart - 1 > line) ?? hunks[0]
+      : [...hunks].reverse().find(h => h.newStart - 1 < line) ?? hunks[hunks.length - 1];
+    revealHunk(editor, target);
+  }
+
+  refresh(): void {
+    const editor = vscode.window.activeTextEditor;
+    const hasHunks = !!editor && hunksOf(this.stateManager, editor.document).length > 0;
+    void vscode.commands.executeCommand('setContext', HAS_HUNKS_CONTEXT, hasHunks);
+  }
+
+  dispose(): void {
+    this.disposables.forEach(d => d.dispose());
+  }
+}
