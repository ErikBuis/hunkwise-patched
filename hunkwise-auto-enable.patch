+// ── Baseline rebasing ───────────────────────────────────────────────────────
+
+/** Split text into line tokens that keep their line ending, the same way Diff.diffLines() does. */
+function lineTokens(text: string): string[] {
+  return text.split(/(?<=\n)/).filter(t => t !== '');
+}
+
+/** A changed region as 0-based, end-exclusive line token ranges in the old and new text. */
+interface TokenHunk { oldStart: number; oldEnd: number; newStart: number; newEnd: number }
+
+function tokenHunks(oldText: string, newText: string): TokenHunk[] {
+  const hunks: TokenHunk[] = [];
+  let oldPos = 0;
+  let newPos = 0;
+  let current: TokenHunk | undefined;
+  for (const change of Diff.diffLines(oldText, newText)) {
+    const n = lineTokens(change.value).length;
+    if (!change.added && !change.removed) {
+      oldPos += n;
+      newPos += n;
+      current = undefined;
+      continue;
+    }
+    if (!current) {
+      current = { oldStart: oldPos, oldEnd: oldPos, newStart: newPos, newEnd: newPos };
+      hunks.push(current);
+    }
+    if (change.removed) {
+      oldPos += n;
+      current.oldEnd = oldPos;
+    } else {
+      newPos += n;
+      current.newEnd = newPos;
+    }
+  }
+  return hunks;
+}
+
+/**
+ * Whether two line ranges touch. Non-empty ranges must share a line; an empty range (an
+ * insertion or deletion point) must lie strictly inside the other range, or two points must coincide.
+ */
+function rangesTouch(aStart: number, aEnd: number, bStart: number, bEnd: number): boolean {
+  const aEmpty = aStart === aEnd;
