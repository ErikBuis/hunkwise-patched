+  if (!lineHeight || !charWidth) return;
+  let dy = wheelPixels(e.wheelDeltaY, e.deltaY, e.deltaMode);
+  let dx = wheelPixels(e.wheelDeltaX, e.deltaX, e.deltaMode);
+  if (Math.abs(dy) >= Math.abs(dx)) dx = 0; else dy = 0;
+  if (e.shiftKey && !isMac && !dx) { dx = dy; dy = 0; }
+  pendingScroll.lines += dy / lineHeight;
+  pendingScroll.columns += dx / charWidth;
+  pendingScroll.fast = e.altKey;
+  if (!scrollFrame) {
+    scrollFrame = requestAnimationFrame(() => {
+      scrollFrame = 0;
+      send({ command: 'scroll', lines: pendingScroll.lines, columns: pendingScroll.columns, fast: pendingScroll.fast });
+      pendingScroll.lines = 0;
+      pendingScroll.columns = 0;
+    });
+  }
+}, { passive: true });
+
+function measure() {
+  const lineHeight = window.innerHeight / HEIGHT_LINES;
+  if (!lineHeight) return;
+  const needed = Math.max(1, Math.round(document.getElementById('content').offsetHeight / lineHeight));
+  if (needed !== HEIGHT_LINES) send({ command: 'resize', lines: needed });
+}
+window.addEventListener('resize', () => { measure(); placeBar(); });
+measure();
+</script>
+</body></html>`;
+}
