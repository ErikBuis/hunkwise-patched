--- /dev/null
+++ b/src/claudeHooks.ts
@@ -0,0 +1,299 @@
+import * as fs from 'fs';
+import * as http from 'http';
+import * as os from 'os';
+import * as path from 'path';
+import { log } from './log';
+
+// Claude Code sends its hook events here (see install.ps1, which registers these hooks).
+export const HOOK_PORT = 47821;
+export const HOOK_PATH = '/hunkwise/claude-hook';
+
+// Claude Code tools that change a file named in their input. Bash is deliberately not tracked:
+// it cannot be attributed to specific files without false positives.
+const FILE_TOOLS = new Set(['Edit', 'Write', 'MultiEdit', 'NotebookEdit']);
+
+const MAX_BODY_BYTES = 64 * 1024 * 1024;
+const MAX_FILE_BYTES = 20 * 1024 * 1024;
+const LEADER_RETRY_MS = 3000;
+const EVENT_TTL_MS = 15 * 60 * 1000;
+const PRUNE_INTERVAL_MS = 60 * 1000;
+const POLL_MS = 1000;
+// A tool call whose end we never hear about (e.g. its permission prompt was rejected) is
+// forgotten after this long.
+const WINDOW_TTL_MS = 10 * 60 * 1000;
+
+/** Directory through which the VSCode window that receives the hooks shares them with all windows. */
+export function claudeEventsDir(): string {
+  return path.join(os.tmpdir(), 'hunkwise-claude-events');
+}
+
+/** Key for comparing paths (Windows paths are case-insensitive, and drive letter case varies). */
+export function pathKey(p: string): string {
+  const resolved = path.resolve(p);
+  return process.platform === 'win32' ? resolved.toLowerCase() : resolved;
+}
+
+/** Read a text file: null when it does not exist, undefined when it cannot be read or is too large. */
+export function readTextSync(filePath: string): string | null | undefined {
+  try {
+    if (fs.statSync(filePath).size > MAX_FILE_BYTES) return undefined;
+    return fs.readFileSync(filePath, 'utf-8');
+  } catch (err: any) {
+    return err?.code === 'ENOENT' ? null : undefined;
+  }
+}
+
+/**
+ * One Claude Code tool call on a file, as shared between VSCode windows. before/after are the
+ * file contents right before and after the call (null: no file, absent: unknown).
+ */
+export interface ClaudeToolEvent {
+  kind: 'pre' | 'post' | 'abandon';
+  id: string;
+  filePath: string;
+  before?: string | null;
+  after?: string | null;
+}
+
+/**
+ * Receives Claude Code's HTTP hooks. Only one VSCode window can listen on the port; it records
+ * every event as a file in claudeEventsDir() for all windows (itself included) to pick up. The
+ * other windows keep retrying, so one of them takes over when the listening window closes.
+ */
+export class ClaudeHookServer {
+  private server: http.Server | undefined;
+  private retryTimer: NodeJS.Timeout | undefined;
+  private counter = 0;
+  private lastPrune = 0;
+  private disposed = false;
+  // Content captured by PreToolUse, repeated in the PostToolUse event for windows that missed it.
+  private beforeById = new Map<string, { before: string | null | undefined; time: number }>();
+
+  constructor(private readonly port = HOOK_PORT, private readonly dir = claudeEventsDir()) {}
+
+  get listening(): boolean {
+    return this.server?.listening ?? false;
+  }
+
+  start(): void {
+    if (this.disposed) return;
+    const server = http.createServer((req, res) => this.handle(req, res));
+    const onStartError = (err: NodeJS.ErrnoException) => {
+      server.close();
+      if (err.code !== 'EADDRINUSE') log(`claude hooks: cannot listen on port ${this.port}: ${err.message}`);
+      if (!this.disposed) this.retryTimer = setTimeout(() => this.start(), LEADER_RETRY_MS);
+    };
+    server.once('error', onStartError);
+    server.listen(this.port, '127.0.0.1', () => {
+      server.off('error', onStartError);
+      server.on('error', err => log(`claude hooks: server error: ${err.message}`));
+      if (this.disposed) { server.close(); return; }
+      this.server = server;
+      log(`claude hooks: receiving Claude Code hooks on 127.0.0.1:${this.port}`);
+    });
+  }
+
+  private handle(req: http.IncomingMessage, res: http.ServerResponse): void {
+    // Claude Code always sends JSON to 127.0.0.1. Rejecting anything else keeps web pages
+    // (which cannot send JSON cross-origin without a preflight) and DNS rebinding out.
+    const host = req.headers.host ?? '';
+    const contentType = req.headers['content-type'] ?? '';
+    if (req.method !== 'POST' || req.url !== HOOK_PATH) {
+      res.writeHead(404).end();
+      return;
+    }
+    if ((host !== `127.0.0.1:${this.port}` && host !== `localhost:${this.port}`) || !contentType.startsWith('application/json')) {
+      res.writeHead(403).end();
+      return;
+    }
+    const chunks: Buffer[] = [];
+    let size = 0;
+    req.on('data', (chunk: Buffer) => {
+      size += chunk.length;
+      if (size > MAX_BODY_BYTES) {
+        res.writeHead(413).end();
+        req.destroy();
+        return;
+      }
+      chunks.push(chunk);
+    });
+    req.on('end', () => {
+      if (size > MAX_BODY_BYTES) return;
+      try {
+        this.process(JSON.parse(Buffer.concat(chunks).toString('utf-8')));
+      } catch (err) {
+        log(`claude hooks: bad hook request: ${err}`);
+      }
+      // Empty 200: no decision, Claude Code carries on as if there was no hook.
+      res.writeHead(200).end();
+    });
+  }
+
+  /** Turn one hook input into a shared event. Runs to completion before Claude Code gets the response. */
+  process(input: any): void {
+    const tool = input?.tool_name;
+    if (!FILE_TOOLS.has(tool)) return;
+    const rawPath = input.tool_input?.file_path ?? input.tool_input?.notebook_path;
+    if (typeof rawPath !== 'string' || rawPath === '') return;
+    const filePath = path.resolve(typeof input.cwd === 'string' ? input.cwd : '', rawPath);
+    const id = typeof input.tool_use_id === 'string' ? input.tool_use_id : `${input.session_id}:${filePath}`;
+
+    switch (input.hook_event_name) {
+      case 'PreToolUse': {
+        const before = readTextSync(filePath);
+        this.beforeById.set(id, { before, time: Date.now() });
+        this.writeEvent({ kind: 'pre', id, filePath, before });
+        break;
+      }
+      case 'PostToolUse':
+      case 'PostToolUseFailure': {
+        const pre = this.beforeById.get(id);
+        this.beforeById.delete(id);
+        const after = readTextSync(filePath);
+        this.writeEvent({ kind: 'post', id, filePath, before: pre?.before, after });
+        break;
+      }
+      case 'PermissionDenied':
+        this.beforeById.delete(id);
+        this.writeEvent({ kind: 'abandon', id, filePath });
+        break;
+    }
+  }
+
+  private writeEvent(event: ClaudeToolEvent): void {
+    fs.mkdirSync(this.dir, { recursive: true });
+    const name = `${String(Date.now()).padStart(15, '0')}-${process.pid}-${String(++this.counter).padStart(6, '0')}.json`;
+    const target = path.join(this.dir, name);
+    // Write then rename, so other windows never read a half-written event.
+    fs.writeFileSync(target + '.tmp', JSON.stringify(event), 'utf-8');
+    fs.renameSync(target + '.tmp', target);
+    this.prune();
+  }
+
+  private prune(): void {
+    const now = Date.now();
+    if (now - this.lastPrune < PRUNE_INTERVAL_MS) return;
+    this.lastPrune = now;
+    for (const [id, entry] of this.beforeById) {
+      if (now - entry.time > EVENT_TTL_MS) this.beforeById.delete(id);
+    }
+    let names: string[];
+    try { names = fs.readdirSync(this.dir); } catch { return; }
+    for (const name of names) {
+      const time = Number(name.slice(0, 15));
+      if (Number.isFinite(time) && now - time > EVENT_TTL_MS) {
+        try { fs.unlinkSync(path.join(this.dir, name)); } catch { /* another window pruned it */ }
+      }
+    }
+  }
+
+  dispose(): void {
+    this.disposed = true;
+    if (this.retryTimer) clearTimeout(this.retryTimer);
+    this.server?.close();
+    this.server = undefined;
+  }
+}
+
+export interface ClaudeToolTrackerHandlers {
+  /** A Claude tool call on filePath is about to change it. */
+  onToolStarted(event: { id: string; filePath: string }): void;
+  /** A Claude tool call on filePath finished (successfully or not). */
+  onToolDone(event: { id: string; filePath: string; before: string | null | undefined; after: string | null | undefined }): void;
+  /** A Claude tool call on filePath will not happen after all, or never reported back. */
+  onAbandoned(event: { id: string; filePath: string }): void;
+}
+
+/** Follows the shared events and knows which files a Claude tool call is currently working on. */
+export class ClaudeToolTracker {
+  private seen = new Set<string>();
+  private open = new Map<string, { filePath: string; key: string; before: string | null | undefined; openedAt: number }>();
+  private watcher: fs.FSWatcher | undefined;
+  private timer: NodeJS.Timeout | undefined;
+  private catchingUp = false;
+
+  constructor(private readonly dir: string, private readonly handlers: ClaudeToolTrackerHandlers) {}
+
+  start(): void {
+    fs.mkdirSync(this.dir, { recursive: true });
+    // Events from before this window started are history, not ours to replay.
+    for (const name of fs.readdirSync(this.dir)) this.seen.add(name);
+    try {
+      this.watcher = fs.watch(this.dir, { persistent: false }, () => this.catchUp());
+    } catch (err) {
+      log(`claude hooks: cannot watch ${this.dir}, polling only: ${err}`);
+    }
+    this.timer = setInterval(() => { this.catchUp(); this.expire(); }, POLL_MS);
+  }
+
+  /**
+   * Whether a Claude tool call on filePath has started but not finished. Reads new events first:
+   * the PreToolUse event is on disk before the tool runs, so it is always seen before the change.
+   */
+  isWorkingOn(filePath: string): boolean {
+    this.catchUp();
+    this.expire();
+    const key = pathKey(filePath);
+    for (const w of this.open.values()) {
+      if (w.key === key) return true;
+    }
+    return false;
+  }
+
+  catchUp(): void {
+    if (this.catchingUp) return;
+    this.catchingUp = true;
+    try {
+      let names: string[];
+      try { names = fs.readdirSync(this.dir); } catch { return; }
+      const present = new Set(names);
+      for (const name of this.seen) {
+        if (!present.has(name)) this.seen.delete(name);
+      }
+      for (const name of names.filter(n => n.endsWith('.json') && !this.seen.has(n)).sort()) {
+        this.seen.add(name);
+        let event: ClaudeToolEvent;
+        try {
+          event = JSON.parse(fs.readFileSync(path.join(this.dir, name), 'utf-8'));
+        } catch {
+          continue;
+        }
+        this.apply(event);
+      }
+    } finally {
+      this.catchingUp = false;
+    }
+  }
+
+  private apply(event: ClaudeToolEvent): void {
+    if (typeof event?.filePath !== 'string' || typeof event.id !== 'string') return;
+    const { id, filePath } = event;
+    if (event.kind === 'pre') {
+      this.open.set(id, { filePath, key: pathKey(filePath), before: event.before, openedAt: Date.now() });
+      this.handlers.onToolStarted({ id, filePath });
+    } else if (event.kind === 'post') {
+      const window = this.open.get(id);
+      this.open.delete(id);
+      const before = window?.before !== undefined ? window.before : event.before;
+      this.handlers.onToolDone({ id, filePath, before, after: event.after });
+    } else if (event.kind === 'abandon') {
+      if (this.open.delete(id)) this.handlers.onAbandoned({ id, filePath });
+    }
+  }
+
+  private expire(): void {
+    const now = Date.now();
+    for (const [id, w] of this.open) {
+      if (now - w.openedAt > WINDOW_TTL_MS) {
+        this.open.delete(id);
+        log(`claude hooks: gave up waiting for Claude to finish with ${path.basename(w.filePath)}`);
+        this.handlers.onAbandoned({ id, filePath: w.filePath });
+      }
+    }
+  }
+
+  dispose(): void {
+    this.watcher?.close();
+    if (this.timer) clearInterval(this.timer);
+  }
+}
