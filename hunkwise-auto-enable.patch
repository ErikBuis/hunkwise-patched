+import { describe, it, beforeEach, afterEach } from 'node:test';
+import assert from 'node:assert/strict';
+import * as fs from 'fs';
+import * as http from 'http';
+import * as net from 'net';
+import * as os from 'os';
+import * as path from 'path';
+import { ClaudeHookServer, ClaudeToolEvent, ClaudeToolTracker, HOOK_PATH } from '../claudeHooks';
+
+let tmpDir: string;
+let eventsDir: string;
+let file: string;
+const servers: ClaudeHookServer[] = [];
+const trackers: ClaudeToolTracker[] = [];
+
+function freePort(): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const probe = net.createServer();
+    probe.once('error', reject);
+    probe.listen(0, '127.0.0.1', () => {
+      const port = (probe.address() as net.AddressInfo).port;
+      probe.close(() => resolve(port));
+    });
+  });
+}
+
+function sleep(ms: number): Promise<void> {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+async function waitFor(condition: () => boolean, timeoutMs = 5000): Promise<void> {
+  const start = Date.now();
+  while (!condition()) {
+    if (Date.now() - start > timeoutMs) throw new Error('Condition not met in time');
+    await sleep(20);
+  }
+}
+
+/** Send a hook request the way Claude Code does. */
+function post(port: number, body: unknown, headers: Record<string, string> = {}, method = 'POST'): Promise<number> {
+  return new Promise((resolve, reject) => {
+    const data = JSON.stringify(body);
+    const req = http.request(
+      { host: '127.0.0.1', port, path: HOOK_PATH, method, headers: { 'Content-Type': 'application/json', ...headers } },
+      res => { res.resume(); res.on('end', () => resolve(res.statusCode ?? 0)); },
+    );
+    req.on('error', reject);
+    req.end(data);
+  });
+}
+
+function hookInput(event: string, tool: string, toolInput: Record<string, unknown>, id = 'toolu_1'): Record<string, unknown> {
+  return { session_id: 's1', cwd: tmpDir, hook_event_name: event, tool_name: tool, tool_input: toolInput, tool_use_id: id };
+}
+
+function readEvents(): ClaudeToolEvent[] {
+  return fs.readdirSync(eventsDir)
+    .filter(n => n.endsWith('.json'))
+    .sort()
+    .map(n => JSON.parse(fs.readFileSync(path.join(eventsDir, n), 'utf-8')));
+}
+
+function newServer(port: number): ClaudeHookServer {
+  const server = new ClaudeHookServer(port, eventsDir);
+  servers.push(server);
+  return server;
+}
+
+beforeEach(() => {
+  tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'hunkwise-hooks-test-'));
+  eventsDir = path.join(tmpDir, 'events');
+  file = path.join(tmpDir, 'file.txt');
+  fs.writeFileSync(file, 'original\n');
+});
+
+afterEach(() => {
+  servers.splice(0).forEach(s => s.dispose());
+  trackers.splice(0).forEach(t => t.dispose());
+  fs.rmSync(tmpDir, { recursive: true, force: true });
+});
+
+describe('ClaudeHookServer', () => {
+  it('records an Edit call with the file content before and after', async () => {
+    const port = await freePort();
+    const server = newServer(port);
+    server.start();
+    await waitFor(() => server.listening);
+
+    assert.equal(await post(port, hookInput('PreToolUse', 'Edit', { file_path: file })), 200);
+    fs.writeFileSync(file, 'changed\n');
+    assert.equal(await post(port, hookInput('PostToolUse', 'Edit', { file_path: file })), 200);
+
+    const [pre, done] = readEvents();
+    assert.equal(pre.kind, 'pre');
+    assert.equal(pre.before, 'original\n');
+    assert.equal(done.kind, 'post');
+    assert.equal(done.before, 'original\n');
+    assert.equal(done.after, 'changed\n');
+    assert.equal(done.id, 'toolu_1');
+  });
+
+  it('records a Write that creates a file with a null before', async () => {
+    const port = await freePort();
+    const server = newServer(port);
+    server.start();
