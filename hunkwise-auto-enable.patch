+
+  it('knows a file is being worked on between the pre and post events', () => {
+    const server = newServer(0);
+    const { tracker, started, done } = newTracker();
+
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    assert.ok(tracker.isWorkingOn(file));
+    assert.deepEqual(started, [{ id: 'toolu_1', filePath: file }], 'The start is reported before the tool writes');
+    if (process.platform === 'win32') assert.ok(tracker.isWorkingOn(file.toUpperCase()), 'Windows paths match case-insensitively');
+    assert.ok(!tracker.isWorkingOn(path.join(tmpDir, 'other.txt')));
+
+    fs.writeFileSync(file, 'changed\n');
+    server.process(hookInput('PostToolUse', 'Edit', { file_path: file }));
+    assert.ok(!tracker.isWorkingOn(file));
+    assert.deepEqual(done, [{ id: 'toolu_1', filePath: file, before: 'original\n', after: 'changed\n' }]);
+  });
+
+  it('treats a failed tool call as finished', () => {
+    const server = newServer(0);
+    const { tracker, done } = newTracker();
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    server.process(hookInput('PostToolUseFailure', 'Edit', { file_path: file }));
+    tracker.catchUp();
+    assert.equal(done.length, 1);
+    assert.equal(done[0].before, done[0].after);
+  });
+
+  it('reports a denied tool call as abandoned', () => {
+    const server = newServer(0);
+    const { tracker, done, abandoned } = newTracker();
+    server.process(hookInput('PreToolUse', 'Write', { file_path: file }));
+    server.process(hookInput('PermissionDenied', 'Write', { file_path: file }));
+    assert.ok(!tracker.isWorkingOn(file));
+    assert.deepEqual(abandoned, [{ id: 'toolu_1', filePath: file }]);
+    assert.equal(done.length, 0);
+  });
+
+  it('ignores events from before it started', () => {
+    const server = newServer(0);
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    const { tracker } = newTracker();
+    assert.ok(!tracker.isWorkingOn(file));
+  });
+
+  it('uses the before content from the post event when it missed the pre event', () => {
+    const server = newServer(0);
+    server.process(hookInput('PreToolUse', 'Edit', { file_path: file }));
+    const { tracker, done } = newTracker();
+    fs.writeFileSync(file, 'changed\n');
+    server.process(hookInput('PostToolUse', 'Edit', { file_path: file }));
+    tracker.catchUp();
+    assert.deepEqual(done, [{ id: 'toolu_1', filePath: file, before: 'original\n', after: 'changed\n' }]);
+  });
+});
diff --git a/src/test/rebaseBaseline.test.ts b/src/test/rebaseBaseline.test.ts
new file mode 100644
index 0000000..e0bf323
--- /dev/null
+++ b/src/test/rebaseBaseline.test.ts
@@ -0,0 +1,99 @@
+import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+import { computeHunks, rebaseBaseline } from '../diffEngine';
+
+/** Join lines into file content with a trailing newline. */
+function lines(...ls: string[]): string {
+  return ls.map(l => l + '\n').join('');
+}
+
+describe('rebaseBaseline', () => {
+  it('keeps pending hunks and absorbs an unrelated change', () => {
+    const baseline = lines('a', 'b', 'c', 'd', 'e', 'f');
+    const before = lines('a', 'B', 'c', 'd', 'e', 'f');
+    const after = lines('a', 'B', 'c', 'd', 'e', 'F', 'g');
+    const result = rebaseBaseline(baseline, before, after);
+    assert.equal(result, lines('a', 'b', 'c', 'd', 'e', 'F', 'g'));
+    const hunks = computeHunks(result, after);
+    assert.equal(hunks.length, 1);
+    assert.deepEqual(hunks[0].removedContent, ['b']);
+    assert.deepEqual(hunks[0].addedContent, ['B']);
+  });
+
+  it('drops a pending hunk that the change touches', () => {
+    const result = rebaseBaseline(lines('a', 'b', 'c'), lines('a', 'B', 'c'), lines('a', 'X', 'c'));
+    assert.deepEqual(computeHunks(result, lines('a', 'X', 'c')), []);
+  });
+
+  it('keeps an untouched hunk while dropping a touched one', () => {
+    const baseline = lines('a', 'b', 'c', 'd', 'e', 'f');
+    const before = lines('a', 'B', 'c', 'd', 'E', 'f');
+    const after = lines('a', 'B', 'c', 'd', 'Z', 'f');
+    const result = rebaseBaseline(baseline, before, after);
+    assert.equal(result, lines('a', 'b', 'c', 'd', 'Z', 'f'));
+    const hunks = computeHunks(result, after);
+    assert.equal(hunks.length, 1);
+    assert.deepEqual(hunks[0].addedContent, ['B']);
+  });
+
+  it('shifts kept hunks past inserted and removed lines', () => {
+    const baseline = lines('a', 'b', 'c', 'd');
+    const before = lines('a', 'b', 'c', 'D');
+    const after = lines('x', 'y', 'a', 'c', 'D');
+    const result = rebaseBaseline(baseline, before, after);
+    assert.equal(result, lines('x', 'y', 'a', 'c', 'd'));
+    const hunks = computeHunks(result, after);
+    assert.equal(hunks.length, 1);
+    assert.deepEqual(hunks[0].removedContent, ['d']);
+    assert.deepEqual(hunks[0].addedContent, ['D']);
+  });
+
+  it('treats a full revert (e.g. Discard Changes in Source Control) as handling every hunk', () => {
+    const head = lines('a', 'b', 'c');
+    const baseline = lines('a', 'b', 'mine', 'c');
+    const before = lines('A', 'b', 'mine', 'c', 'claude');
+    const result = rebaseBaseline(baseline, before, head);
+    assert.deepEqual(computeHunks(result, head), []);
+  });
+
+  it('keeps a pending insertion when the change inserts right after it', () => {
+    const baseline = lines('a', 'b', 'c');
+    const before = lines('a', 'b', 'NEW', 'c');
+    const after = lines('a', 'b', 'NEW', 'U', 'c');
+    const result = rebaseBaseline(baseline, before, after);
+    assert.equal(result, lines('a', 'b', 'U', 'c'));
+    const hunks = computeHunks(result, after);
+    assert.equal(hunks.length, 1);
+    assert.deepEqual(hunks[0].addedContent, ['NEW']);
+  });
+
+  it('keeps a pending deletion when an unrelated line is added elsewhere', () => {
+    const baseline = lines('a', 'gone', 'b', 'c');
+    const before = lines('a', 'b', 'c');
+    const after = lines('a', 'b', 'c', 'd');
+    const result = rebaseBaseline(baseline, before, after);
+    assert.equal(result, lines('a', 'gone', 'b', 'c', 'd'));
+    const hunks = computeHunks(result, after);
+    assert.equal(hunks.length, 1);
+    assert.deepEqual(hunks[0].removedContent, ['gone']);
+  });
+
+  it('accepts a file created by the tool once the change edits it', () => {
+    const after = lines('x', 'Y');
+    const result = rebaseBaseline(null, lines('x', 'y'), after);
+    assert.equal(result, after);
+  });
+
+  it('handles content without a trailing newline', () => {
+    const result = rebaseBaseline('a\nb', 'a\nB', 'Z\na\nB');
+    assert.equal(result, 'Z\na\nb');
+    const hunks = computeHunks(result, 'Z\na\nB');
+    assert.equal(hunks.length, 1);
+    assert.deepEqual(hunks[0].removedContent, ['b']);
+  });
+
+  it('returns after unchanged when nothing was pending', () => {
+    const text = lines('a', 'b');
+    assert.equal(rebaseBaseline(text, text, lines('a', 'b', 'c')), lines('a', 'b', 'c'));
+  });
+});
