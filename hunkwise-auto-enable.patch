+// HTML of the inset hunkwise shows above each hunk. Kept free of the vscode API so it can be unit tested.
+import type { LineRange } from './diffEngine';
+
+// ── HTML helpers ─────────────────────────────────────────────────────────────
+function escapeHtml(s: string): string {
+  return s
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+}
+
+/** One removed line as HTML, with its changed parts (sorted, non-overlapping) highlighted. */
+function lineHtml(text: string, changed: LineRange[]): string {
+  let html = '';
+  let pos = 0;
+  for (const { start, end } of changed) {
+    html += escapeHtml(text.slice(pos, start)) + `<span class="changed">${escapeHtml(text.slice(start, end))}</span>`;
+    pos = end;
+  }
+  return html + escapeHtml(text.slice(pos));
+}
